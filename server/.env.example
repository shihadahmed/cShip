# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas (required in production; uncomment and fill in to enable)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/cship?retryWrites=true&w=majority

# Dashboard origin(s), comma-separated
CLIENT_ORIGIN=http://localhost:3000

# Public base URL of this API (used for GitHub webhook callbacks)
PUBLIC_SERVER_URL=http://localhost:4000

# Sessions and encryption (Phase 2; required in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=
# TOKEN_ENCRYPTION_KEY=

# GitHub OAuth (Phase 2)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
# Comma-separated GitHub logins allowed to use cShip. This is the source of
# truth: users removed from this list lose access on their next request.
ADMIN_GITHUB_LOGINS=your-github-login

# Request body limit for JSON payloads (default 1mb)
# BODY_SIZE_LIMIT=1mb

# cPanel UAPI (Phase 3)
CPANEL_URL=https://cpanel.example.com:2083
CPANEL_USERNAME=your_cpanel_user
CPANEL_API_TOKEN=
DEPLOYMENTS_ROOT=/home/your_cpanel_user/cship/apps

# Build safety
BUILD_MEMORY_MB=512
MAX_CONCURRENT_BUILDS=1
BUILD_TIMEOUT_MS=900000
SSE_HEARTBEAT_MS=15000

# Redis for distributed rate limiting (optional; enables multi-instance rate limiting)
# REDIS_URL=redis://localhost:6379
# Or use discrete config:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
